---
import '@fontsource/sora/latin-400.css';
import '@fontsource/sora/latin-600.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import AtomeLandingLayout from '../layouts/AtomeLandingLayout.astro';
import AtomeLandingHeaderV2 from './AtomeLandingHeaderV2.astro';
import LandingIcon from './LandingIcon.astro';
import { siteConfig } from '../config/site';

interface Props {
  language?: 'bm' | 'en';
}

const { language = 'bm' } = Astro.props;
const basePath = '/atome-2';

const content = {
  bm: {
    metaTitle: 'Atome Merchant Enquiry',
    metaDescription:
      'Tawarkan Atome Buy Now Pay Later di bisnes anda. Novalink semak kelayakan, terangkan dokumen yang perlu, dan bantu sampai onboarding.',
    whatsappMessage:
      'Hi Novalink, saya nak tawarkan Atome di bisnes saya.\n\nNama bisnes:\nJenis bisnes:\nLokasi:\n\n(Ref: ATOME-2)',
    headerCta: 'Semak kelayakan',
    stickyCta: 'Semak kelayakan percuma',
    hero: {
      eyebrow: 'Untuk merchant di Malaysia',
      headline: 'Tawarkan Atome di bisnes anda.',
      highlight: 'Kami bantu uruskan prosesnya.',
      subheadline:
        'Pelanggan beli sekarang dan bayar 3 kali tanpa faedah. Kami semak kelayakan bisnes anda, senaraikan dokumen yang perlu, dan bantu sampai onboarding selesai.',
      primaryCta: 'Semak kelayakan percuma',
      secondaryCta: 'Lihat prosesnya',
      ctaNote: 'Terus ke WhatsApp. Mesej sudah disediakan.',
      stats: [
        { prefix: 'RM', value: '0', label: 'Setup fee' },
        { prefix: 'RM', value: '0', label: 'Yuran bulanan' },
        { value: '3x', label: 'Bayaran tanpa faedah' },
      ],
      disclosure: 'Novalink bukan sebahagian daripada Atome. Kelulusan akhir tertakluk pada semakan Atome.',
      imageAlt: 'Pelanggan bayar guna app Atome di kaunter kedai',
      badgeQr: 'Bayar guna QR',
      badgeCheck: 'Semakan awal percuma',
      badgeCheckSub: 'melalui WhatsApp',
    },
    whyNovalink: {
      eyebrow: 'Kenapa melalui Novalink',
      title: 'Tahu apa yang Atome perlukan, sebelum anda mohon.',
      lead: 'Kami bukan pasukan Atome. Kami bantu merchant sediakan maklumat yang betul supaya proses semakan lebih lancar.',
      items: [
        {
          icon: 'shield-check',
          title: 'Semakan kelayakan awal',
          body: 'Kami semak bisnes anda dulu: pendaftaran, signboard, cashier counter atau checkout page. Anda tahu apa yang kurang sebelum mohon.',
        },
        {
          icon: 'clipboard-check',
          title: 'Senarai dokumen yang jelas',
          body: 'Kami beritahu apa yang perlu disediakan, seperti SSM, MyKad dan penyata bank, supaya tak perlu berulang-alik.',
        },
        {
          icon: 'message-circle',
          title: 'Semua dalam satu chat WhatsApp',
          body: 'Tanya soalan, hantar dokumen dan dapat update dalam satu chat, dari enquiry sampai kontrak.',
        },
      ],
    },
    whyAtome: {
      eyebrow: 'Kenapa Atome',
      title: 'Beri pelanggan cara bayar yang lebih mudah.',
      lead: 'Atome ialah pilihan Buy Now Pay Later (BNPL). Pelanggan buat bayaran pertama semasa beli, dan baki dijadualkan dalam app Atome.',
      items: [
        {
          icon: 'credit-card',
          title: 'Tak perlu credit card',
          body: 'Ramai pelanggan, terutamanya golongan muda, tak ada credit card. Atome beri mereka pilihan ansuran melalui app.',
        },
        {
          icon: 'calendar',
          title: '3 kali bayaran tanpa faedah',
          body: 'Bila bayaran boleh dipecahkan, pelanggan biasanya lebih selesa teruskan pembelian yang lebih besar.',
        },
        {
          icon: 'megaphone',
          title: 'Dipaparkan dalam app Atome',
          body: 'Merchant berpeluang dapat visibility dalam app Atome, termasuk kempen atau voucher tertentu.',
        },
        {
          icon: 'wallet',
          title: 'Atome uruskan bayaran balik',
          body: 'Kutipan ansuran daripada pelanggan diuruskan sepenuhnya oleh Atome.',
        },
      ],
      pricing: {
        label: 'Yuran merchant',
        items: [
          { prefix: 'RM', value: '0', label: 'Setup fee' },
          { prefix: 'RM', value: '0', label: 'Yuran bulanan' },
        ],
        body: 'Hanya caj MDR bagi setiap transaksi. Struktur biasa untuk merchant yang kami uruskan ialah 6% + RM1 setiap transaksi.',
        note: 'Merchant dengan GMV tinggi atau banyak cawangan mungkin boleh runding kadar lebih rendah. Terma akhir disahkan semasa onboarding.',
        cta: 'Tanya tentang yuran',
      },
    },
    process: {
      eyebrow: 'Proses',
      title: 'Dari WhatsApp pertama sampai kontrak.',
      lead: 'Biasanya sehingga 2 minggu sebelum kontrak sedia untuk ditandatangani, bergantung pada dokumen dan semakan Atome.',
      steps: [
        {
          title: 'WhatsApp kami',
          body: 'Hantar nama bisnes, jenis bisnes dan lokasi. Mesej sudah disediakan untuk anda.',
        },
        {
          title: 'Semakan awal',
          body: 'Kami semak kesesuaian bisnes anda dan terangkan apa yang perlu disediakan.',
        },
        {
          title: 'Sediakan dokumen',
          body: 'Kami bantu susun dokumen dan maklumat untuk semakan Atome.',
        },
        {
          title: 'Onboarding & kontrak',
          body: 'Atome buat keputusan akhir. Kami bantu sampai onboarding selesai.',
        },
      ],
    },
    fit: {
      eyebrow: 'Sesuai untuk',
      title: 'Bisnes yang biasa kami bantu',
      body: 'Kedai fizikal atau online, terutamanya bila harga barang atau servis agak tinggi dan ansuran boleh bantu pelanggan buat keputusan.',
      categories: [
        'Telefon & elektronik',
        'Kecantikan & estetik',
        'Klinik & pergigian',
        'Perabot & perkakas rumah',
        'Fesyen & barang kemas',
        'Automotif & aksesori',
        'Pendidikan & kursus',
        'Kedai online',
      ],
      requirementsTitle: 'Syarat biasa Atome',
      requirements: [
        { text: 'Bisnes berdaftar di Malaysia (SSM)' },
        { text: 'Signboard kedai yang proper, bukan sekadar banner', tag: 'Kedai fizikal' },
        { text: 'Cashier counter', tag: 'Kedai fizikal' },
        { text: 'Checkout page yang berfungsi', tag: 'Online' },
        { text: 'Senarai produk atau SKU, kalau diminta' },
      ],
      requirementsNote: 'Tak pasti bisnes anda layak?',
      requirementsCta: 'Kami boleh semak dulu',
    },
    faq: {
      eyebrow: 'Soalan lazim',
      title: 'Ada soalan lain?',
      body: 'WhatsApp kami dan kami terangkan dengan lebih lanjut.',
      cta: 'Tanya di WhatsApp',
      items: [
        {
          question: 'Adakah Novalink sebahagian daripada Atome?',
          answer:
            'Bukan. Novalink bantu uruskan enquiry merchant dan panduan onboarding. Kami bukan pasukan dalaman Atome.',
        },
        {
          question: 'Enquiry ini jamin kelulusan?',
          answer: 'Tidak. Enquiry awal tak jamin kelulusan. Keputusan akhir di pihak Atome selepas semakan.',
        },
        {
          question: 'Saya perlu hardware khas atau integration?',
          answer:
            'Tak semestinya. Untuk kedai fizikal, Atome guna pembayaran secara QR. Untuk kedai online, integration bergantung pada platform dan saluran jualan anda.',
        },
        {
          question: 'Macam mana kalau saya jalankan kedai online?',
          answer:
            'Boleh, tapi laman anda perlu ada checkout page yang proper. Dalam sesetengah kes, Atome mungkin minta screenshot atau live demo semasa assessment.',
        },
        {
          question: 'Boleh ke dapat kadar lebih rendah daripada 6%?',
          answer:
            'Boleh, dalam sesetengah keadaan. Merchant dengan GMV tinggi, banyak cawangan, atau jenama yang kuat berkemungkinan boleh runding kadar yang lebih baik dengan Atome.',
        },
        {
          question: 'Macam mana kalau pelanggan tak bayar balik kepada Atome?',
          answer:
            'Bayaran balik pelanggan diuruskan sepenuhnya oleh Atome. Aliran settlement dan terma berkaitan akan dijelaskan kepada merchant semasa onboarding.',
        },
        {
          question: 'Atome akan minta product list?',
          answer: 'Kadang-kadang, terutamanya semasa assessment. Elok sediakan SKU atau product list lebih awal.',
        },
        {
          question: 'Macam mana kalau bisnes saya dalam kategori berisiko tinggi?',
          answer:
            'Semakan mungkin ambil masa lebih lama. Atome mungkin minta dokumen atau kelulusan tambahan bergantung pada kategori bisnes.',
        },
      ],
    },
    finalCta: {
      title: 'Semak kelayakan bisnes anda hari ini.',
      body: 'Hantar nama bisnes, jenis bisnes dan lokasi. Kami buat semakan awal dan terangkan langkah seterusnya.',
      cta: 'Semak kelayakan percuma',
      disclosure:
        'Novalink bantu uruskan enquiry merchant dan panduan onboarding. Kami bukan pasukan dalaman Atome. Kelayakan dan kelulusan akhir bergantung pada semakan dan keperluan Atome.',
    },
  },
  en: {
    metaTitle: 'Atome Merchant Enquiry',
    metaDescription:
      'Offer Atome Buy Now Pay Later at your business. Novalink checks your eligibility, explains the documents you need, and supports you through onboarding.',
    whatsappMessage:
      "Hi Novalink, I'd like to offer Atome at my business.\n\nBusiness name:\nBusiness type:\nLocation:\n\n(Ref: ATOME-2)",
    headerCta: 'Check eligibility',
    stickyCta: 'Check eligibility for free',
    hero: {
      eyebrow: 'For merchants in Malaysia',
      headline: 'Offer Atome at your business.',
      highlight: 'We help you through the process.',
      subheadline:
        'Customers buy now and pay in 3 interest-free instalments. We check your eligibility, list the documents you need, and support you until onboarding is done.',
      primaryCta: 'Check eligibility for free',
      secondaryCta: 'See how it works',
      ctaNote: 'Opens WhatsApp with a ready-made message.',
      stats: [
        { prefix: 'RM', value: '0', label: 'Setup fee' },
        { prefix: 'RM', value: '0', label: 'Monthly fee' },
        { value: '3x', label: 'Interest-free payments' },
      ],
      disclosure: 'Novalink is not part of Atome. Final approval is subject to Atome’s review.',
      imageAlt: 'Customer paying with the Atome app at a store counter',
      badgeQr: 'Pay by QR',
      badgeCheck: 'Free initial check',
      badgeCheckSub: 'via WhatsApp',
    },
    whyNovalink: {
      eyebrow: 'Why go through Novalink',
      title: 'Know what Atome needs before you apply.',
      lead: 'We are not part of Atome. We help merchants prepare the right information so the review goes more smoothly.',
      items: [
        {
          icon: 'shield-check',
          title: 'Early eligibility check',
          body: 'We check your business first: registration, signboard, cashier counter or checkout page. You know what is missing before you apply.',
        },
        {
          icon: 'clipboard-check',
          title: 'A clear document list',
          body: 'We tell you what to prepare, such as SSM, MyKad and bank statements, so there is less back-and-forth.',
        },
        {
          icon: 'message-circle',
          title: 'Everything in one WhatsApp chat',
          body: 'Ask questions, send documents and get updates in one chat, from enquiry to contract.',
        },
      ],
    },
    whyAtome: {
      eyebrow: 'Why Atome',
      title: 'Give customers an easier way to pay.',
      lead: 'Atome is a Buy Now Pay Later (BNPL) option. Customers make the first payment at purchase, and the rest is scheduled in the Atome app.',
      items: [
        {
          icon: 'credit-card',
          title: 'No credit card needed',
          body: 'Many customers, especially younger ones, do not have a credit card. Atome gives them an instalment option through the app.',
        },
        {
          icon: 'calendar',
          title: '3 interest-free payments',
          body: 'When payments can be split, customers are usually more comfortable going ahead with bigger purchases.',
        },
        {
          icon: 'megaphone',
          title: 'Featured in the Atome app',
          body: 'Merchants may gain visibility in the Atome app, including selected campaigns or vouchers.',
        },
        {
          icon: 'wallet',
          title: 'Atome handles repayments',
          body: 'Collecting instalments from customers is handled entirely by Atome.',
        },
      ],
      pricing: {
        label: 'Merchant fees',
        items: [
          { prefix: 'RM', value: '0', label: 'Setup fee' },
          { prefix: 'RM', value: '0', label: 'Monthly fee' },
        ],
        body: 'Only an MDR per transaction. The usual structure for merchants we handle is 6% + RM1 per transaction.',
        note: 'Merchants with high GMV or multiple branches may be able to negotiate a lower rate. Final terms are confirmed during onboarding.',
        cta: 'Ask about fees',
      },
    },
    process: {
      eyebrow: 'Process',
      title: 'From first WhatsApp to signed contract.',
      lead: 'Usually up to 2 weeks before the contract is ready to sign, depending on your documents and Atome’s review.',
      steps: [
        {
          title: 'WhatsApp us',
          body: 'Send your business name, business type and location. The message is pre-filled for you.',
        },
        {
          title: 'Initial check',
          body: 'We check whether your business is a fit and explain what to prepare.',
        },
        {
          title: 'Prepare documents',
          body: 'We help you put together the documents and details for Atome’s review.',
        },
        {
          title: 'Onboarding & contract',
          body: 'Atome makes the final decision. We support you until onboarding is complete.',
        },
      ],
    },
    fit: {
      eyebrow: 'Good fit for',
      title: 'Businesses we usually help',
      body: 'Physical or online stores, especially where prices are higher and instalments help customers decide.',
      categories: [
        'Phones & electronics',
        'Beauty & aesthetics',
        'Clinics & dental',
        'Furniture & home appliances',
        'Fashion & jewellery',
        'Automotive & accessories',
        'Education & courses',
        'Online stores',
      ],
      requirementsTitle: 'Typical Atome requirements',
      requirements: [
        { text: 'Business registered in Malaysia (SSM)' },
        { text: 'A proper shop signboard, not just a banner', tag: 'Physical store' },
        { text: 'A cashier counter', tag: 'Physical store' },
        { text: 'A working checkout page', tag: 'Online' },
        { text: 'Product or SKU list, if requested' },
      ],
      requirementsNote: 'Not sure if your business qualifies?',
      requirementsCta: 'We can check first',
    },
    faq: {
      eyebrow: 'FAQ',
      title: 'Have another question?',
      body: 'WhatsApp us and we will walk you through it.',
      cta: 'Ask on WhatsApp',
      items: [
        {
          question: 'Is Novalink part of Atome?',
          answer:
            'No. Novalink supports merchant enquiry coordination and onboarding guidance. Novalink is not part of Atome’s internal team.',
        },
        {
          question: 'Does this enquiry guarantee approval?',
          answer:
            'No. An initial enquiry does not guarantee approval. Eligibility and approval remain subject to Atome’s review.',
        },
        {
          question: 'Do I need special hardware or integration?',
          answer:
            'Not necessarily. For physical stores, Atome uses a QR-based payment flow. For online stores, integration depends on your platform and sales channels.',
        },
        {
          question: 'What if I run an online shop?',
          answer:
            'You may still apply, but your site should have a proper checkout page. In some cases, Atome may request screenshots or a live demo during assessment.',
        },
        {
          question: 'Can merchants get a lower rate than 6%?',
          answer:
            'Yes, in some cases. Merchants with high GMV, multiple branches, or a strong brand profile may be able to negotiate a better rate with Atome.',
        },
        {
          question: 'What happens if the customer does not pay Atome back?',
          answer:
            'Customer repayment is handled under Atome’s own process. Merchant settlement flow and related terms will be clarified during onboarding.',
        },
        {
          question: 'Will Atome ask for my product list?',
          answer:
            'Sometimes, especially during assessment. Be ready to provide an SKU or product list if requested.',
        },
        {
          question: 'What if my business is in a higher-risk category?',
          answer:
            'This may require a more thorough review. Atome may request additional documents or approvals depending on the business category.',
        },
      ],
    },
    finalCta: {
      title: 'Check if your business qualifies today.',
      body: 'Send your business name, business type and location. We will do an initial check and explain the next steps.',
      cta: 'Check eligibility for free',
      disclosure:
        'Novalink supports merchant enquiry coordination and onboarding guidance. Novalink is not part of Atome’s internal team. Eligibility and approval remain subject to Atome’s review and requirements.',
    },
  },
} as const;

const t = content[language];
const pageLang = language === 'bm' ? 'ms' : 'en';
const whatsappLink = `https://wa.me/${siteConfig.phoneE164}?text=${encodeURIComponent(t.whatsappMessage)}`;

const ctaPrimary =
  'inline-flex h-14 items-center justify-center gap-2.5 rounded-full bg-brand-500 px-7 text-base font-semibold text-slate-950 shadow-[0_12px_32px_-12px_rgba(245,141,61,0.8)] transition hover:bg-brand-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500';
const ctaDark =
  'inline-flex h-12 items-center justify-center gap-2 rounded-full bg-slate-950 px-6 text-base font-semibold text-white transition hover:bg-slate-800';
const eyebrowLight = 'inline-flex rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-800';
const eyebrowDark = 'inline-flex rounded-full bg-white/10 px-3 py-1 text-sm font-semibold text-brand-200';
const sectionTitle = 'mt-4 text-3xl font-bold leading-[1.1] tracking-tight sm:text-4xl lg:text-5xl';
const sectionLead = 'mt-4 text-base leading-relaxed sm:text-lg';
---

<AtomeLandingLayout
  title={t.metaTitle}
  description={t.metaDescription}
  ogImage="/atome-og.jpg"
  lang={pageLang}
  language={language}
  basePath={basePath}
  primaryCtaLabel={t.headerCta}
  primaryCtaHref={whatsappLink}
  mainClass=""
  noIndex={true}
>
  <AtomeLandingHeaderV2
    slot="header"
    language={language}
    basePath={basePath}
    primaryCtaLabel={t.headerCta}
    primaryCtaHref={whatsappLink}
  />

  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-48 right-[-15%] h-[34rem] w-[34rem] rounded-full bg-brand-500/25 blur-3xl"></div>
      <div class="absolute -bottom-56 -left-40 h-[30rem] w-[30rem] rounded-full bg-brand-600/15 blur-3xl"></div>
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_at_top,black_20%,transparent_70%)]"
      >
      </div>
    </div>

    <div class="container-shell grid gap-10 pb-12 pt-8 sm:gap-12 sm:pb-16 sm:pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-14 lg:pb-24 lg:pt-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-slate-200">
          <span class="h-2 w-2 rounded-full bg-brand-500" aria-hidden="true"></span>
          {t.hero.eyebrow}
        </p>
        <h1 class="mt-6 text-[2.5rem] font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-[3.5rem]">
          {t.hero.headline}
          <span class="mt-1 block text-brand-500">{t.hero.highlight}</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">{t.hero.subheadline}</p>

        <div data-sticky-cta-hide class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={whatsappLink}
            onclick="gtag_report_conversion();"
            target="_blank"
            rel="noopener noreferrer"
            class={ctaPrimary}
          >
            <LandingIcon name="whatsapp" class="h-5 w-5" />
            {t.hero.primaryCta}
          </a>
          <a
            href="#proses"
            class="inline-flex h-14 items-center justify-center rounded-full border border-white/20 px-7 text-base font-semibold text-white transition hover:bg-white/10"
          >
            {t.hero.secondaryCta}
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-400">{t.hero.ctaNote}</p>

        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-white/10 pt-6">
          {
            t.hero.stats.map((stat) => (
              <div class="flex flex-col-reverse justify-end gap-1">
                <dt class="text-sm leading-snug text-slate-400">{stat.label}</dt>
                <dd class="font-display text-3xl font-bold text-white sm:text-4xl">
                  {'prefix' in stat && <span class="mr-1 text-lg font-semibold text-slate-400 sm:text-xl">{stat.prefix}</span>}{stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 text-sm leading-relaxed text-slate-400">{t.hero.disclosure}</p>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <div class="overflow-hidden rounded-[2rem] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)] ring-1 ring-white/10">
          <img
            src="/atome-hero-retail.jpeg"
            alt={t.hero.imageAlt}
            width="1197"
            height="887"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <div class="absolute -right-2 top-5 flex items-center gap-2 rounded-2xl bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-950 shadow-xl sm:-right-5">
          <LandingIcon name="qr-code" class="h-5 w-5 text-brand-600" />
          {t.hero.badgeQr}
        </div>
        <div class="absolute -left-2 bottom-5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-xl sm:-left-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#25D366] text-white">
            <LandingIcon name="whatsapp" class="h-5 w-5" />
          </span>
          <span>
            <span class="block text-sm font-semibold text-slate-950">{t.hero.badgeCheck}</span>
            <span class="block text-xs text-slate-500">{t.hero.badgeCheckSub}</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 sm:py-24">
    <div class="container-shell">
      <div class="max-w-2xl">
        <p class={eyebrowLight}>{t.whyNovalink.eyebrow}</p>
        <h2 class={`${sectionTitle} text-slate-950`}>{t.whyNovalink.title}</h2>
        <p class={`${sectionLead} text-slate-600`}>{t.whyNovalink.lead}</p>
      </div>
      <div class="mt-8 grid gap-7 md:mt-12 md:grid-cols-3 md:gap-5">
        {
          t.whyNovalink.items.map((item) => (
            <article class="flex gap-4 md:flex-col md:gap-0 md:rounded-3xl md:border md:border-slate-200 md:bg-slate-50 md:p-7">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-500 text-slate-950">
                <LandingIcon name={item.icon} class="h-6 w-6" />
              </span>
              <div class="md:mt-6">
                <h3 class="text-xl font-semibold text-slate-950">{item.title}</h3>

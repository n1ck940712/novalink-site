---
import AtomeLandingLayout from '../layouts/AtomeLandingLayout.astro';
import { siteConfig } from '../config/site';

const whatsappLink = `https://wa.me/${siteConfig.phoneE164}`;
interface Props {
  language?: 'bm' | 'en';
  variant?: 'offer' | 'register';
}

const { language = 'bm', variant = 'offer' } = Astro.props;
const basePath = variant === 'register' ? '/atome-1' : '/atome';

const content = {
  bm: {
    metaTitle: 'Atome Merchant Enquiry',
    metaDescription:
      'Halaman enquiry merchant Atome. Novalink bantu anda faham langkah pertama, buat semakan awal, dan uruskan proses onboarding.',
    hero: {
      headline: 'Nak tawarkan Atome kepada pelanggan anda?',
      subheadline:
        'Tambah satu lagi pilihan bayaran di checkout anda. Kami bantu dari enquiry sampai onboarding.',
      supportLine:
        'Atome ialah pilihan Buy Now Pay Later (BNPL) yang benarkan pelanggan beli sekarang dan bayar secara ansuran.',
      trustLine: 'Tiada setup fee · Tiada monthly fee',
      primaryCta: 'Buat enquiry merchant',
      secondaryText: 'WhatsApp untuk maklumat lanjut',
    },
    explainer: {
      title: 'Apa itu Atome Buy Now Pay Later?',
      bullets: [
        'Pelanggan beli sekarang, bayar secara ansuran',
        'Atome Malaysia tawarkan pilihan 3 kali bayaran tanpa faedah',
        'Untuk sesetengah transaksi, ada pilihan tempoh lebih panjang dengan caj yang dipaparkan dalam app',
        'Bayaran pertama dibuat semasa pembelian, baki bayaran dijadualkan dalam app',
        'Untuk merchant, ini satu lagi pilihan bayaran di checkout anda',
      ],
      linkLabel: 'Rujuk laman rasmi Atome Malaysia',
      linkHref: 'https://www.atome.my/how-it-works',
    },
    why: {
      title: 'Kenapa merchant pilih Atome',
      cards: [
        {
          title: 'Beri pelanggan lebih pilihan bayaran',
          body: 'Satu lagi cara untuk pelanggan bayar di checkout, bergantung pada kesesuaian bisnes dan transaksi.',
        },
        {
          title: 'Bantu pelanggan buat keputusan',
          body: 'Bila bayaran boleh dipecahkan kepada ansuran, pelanggan biasanya lebih selesa untuk teruskan pembelian yang lebih besar.',
        },
        {
          title: 'Tiada setup fee, tiada monthly fee',
          body: 'Merchant hanya dikenakan caj MDR bagi setiap transaksi. Terma penuh akan dijelaskan semasa onboarding.',
        },
        {
          title: 'Panduan jelas untuk setiap langkah',
          body: 'Kami terangkan apa yang perlu disediakan, apa yang Atome akan semak, dan apa yang berlaku selepas itu.',
        },
      ],
    },
    howItWorks: {
      title: 'Macam mana prosesnya',
      steps: [
        {
          title: 'Hantar enquiry',
          body: 'WhatsApp kami untuk semakan awal. Cukup dengan maklumat asas bisnes anda.',
        },
        {
          title: 'Kongsi maklumat bisnes',
          body: 'Kami tanya perkara asas: jenis bisnes, lokasi, dan saluran jualan anda.',
        },
        {
          title: 'Dapat panduan langkah seterusnya',
          body: 'Kalau bisnes anda sesuai, kami beritahu apa yang perlu disediakan dan apa yang akan berlaku selepas itu.',
        },
        {
          title: 'Teruskan onboarding',
          body: 'Kami bantu sampai proses onboarding selesai. Kelulusan akhir tetap bergantung pada semakan Atome.',
        },
      ],
    },
    suitableFor: {
      title: 'Sesuai untuk bisnes macam ini…',
      bullets: [
        'Kedai yang nak beri pelanggan lebih pilihan bayaran',
        'Bisnes dengan harga barang agak tinggi, di mana ansuran boleh bantu pelanggan buat keputusan',
        'Merchant yang sedia lalui proses semakan dan onboarding',
        'Bisnes online atau offline yang nak tambah pilihan bayaran secara tersusun',
      ],
    },
    prepare: {
      title: 'Apa yang perlu disediakan sebelum enquiry',
      intro: 'Untuk cepatkan semakan awal, sediakan maklumat ini:',
      bullets: ['Nama bisnes', 'Jenis bisnes', 'Lokasi / kawasan', 'Laman web atau page media sosial, kalau ada'],
      primaryCta: 'Buat enquiry merchant',
      secondaryText: 'WhatsApp untuk semakan awal',
    },
    faq: {
      title: 'Soalan Lazim',
      mainItems: [
        {
          question: 'Adakah Novalink sebahagian daripada Atome?',
          answer:
            'Bukan. Novalink bantu uruskan enquiry merchant dan panduan onboarding. Kami bukan pasukan dalaman Atome.',
        },
        {
          question: 'Semua bisnes layak ke?',
          answer: 'Tak semestinya. Kesesuaian bergantung pada semakan dan keperluan Atome.',
        },
        {
          question: 'Enquiry ini jamin kelulusan?',
          answer: 'Tidak. Enquiry awal tak jamin kelulusan. Keputusan akhir di pihak Atome selepas semakan.',
        },
        {
          question: 'Apa maklumat yang diperlukan untuk mula?',
          answer:
            'Maklumat asas sahaja: nama bisnes, jenis bisnes, lokasi, dan saluran jualan anda.',
        },
        {
          question: 'Ada kena bayar apa-apa untuk buat enquiry?',
          answer: 'Tiada. Semakan awal melalui enquiry adalah percuma.',
        },
        {
          question: 'Saya perlu hardware khas atau integration?',
          answer:
            'Tak semestinya. Untuk kedai fizikal, Atome guna pembayaran secara QR. Untuk kedai online, integration bergantung pada platform dan saluran jualan anda.',
        },
        {
          question: 'Boleh ke bisnes saya dipaparkan dalam app Atome?',
          answer:
            'Boleh. Atome ada ruang untuk paparkan merchant dalam app, tertakluk pada proses dan keperluan mereka.',
        },
        {
          question: 'Semua pelanggan dapat limit yang sama?',
          answer:
            'Tidak. Kelayakan dan limit berbeza ikut profil pengguna, jenis pembayaran, dan penilaian Atome.',
        },
        {
          question: 'Macam mana yuran merchant dikira?',
          answer:
            'Tiada setup fee dan tiada monthly fee. Merchant hanya dikenakan MDR bagi setiap transaksi, dan terma komersial akan dijelaskan semasa onboarding.',
        },
      ],
      supportLine:
        'Ada soalan tentang yuran, onboarding, kesesuaian bisnes, atau kedai online? WhatsApp kami untuk semakan awal.',
      moreTitle: 'Lebih banyak soalan merchant',
      moreGroups: [
        {
          title: 'Yuran & terma komersial',
          items: [
            {
              question: 'Apa beza Atome dengan pilihan pay-later lain?',
              answer:
                'Atome bukan sekadar satu lagi pilihan bayaran di checkout. Merchant juga berpeluang dipaparkan dalam app Atome, disokong dengan kempen atau voucher tertentu, dan lebih mudah dicapai oleh pengguna debit card yang tak guna credit card.',
            },
            {
              question: 'Macam mana kalau pelanggan tak bayar balik kepada Atome?',
              answer:
                'Bayaran balik pelanggan diuruskan sepenuhnya oleh Atome. Aliran settlement dan terma berkaitan akan dijelaskan kepada merchant semasa onboarding.',
            },
            {
              question: 'Ramai ke orang guna Atome?',
              answer:
                'Atome ada pangkalan pengguna yang besar di Malaysia dan rantau ini. Selain checkout, merchant juga berpeluang dapat visibility dalam app Atome.',
            },
            {
              question: 'Berapa yuran Atome?',
              answer:
                'Untuk merchant yang kami uruskan, struktur biasa ialah 6% + RM1 bagi setiap transaksi. Tiada setup fee, tiada monthly fee. Pengesahan akhir tertakluk pada terma onboarding semasa.',
            },
            {
              question: 'Boleh ke dapat kadar lebih rendah daripada 6%?',
              answer:
                'Boleh, dalam sesetengah keadaan. Merchant dengan GMV tinggi, banyak cawangan, atau jenama yang kuat berkemungkinan boleh runding kadar yang lebih baik dengan Atome.',
            },
            {
              question: 'Semua pelanggan ada credit limit yang sama?',
              answer:
                'Tidak. Limit berbeza ikut profil pengguna, jenis pembayaran, dan rekod pembayaran mereka.',
            },
          ],
        },
        {
          title: 'Setup & onboarding',
          items: [
            {
              question: 'Onboarding ni susah tak?',
              answer:
                'Tak susah kalau maklumat asas dan dokumen disediakan awal. Kami bantu anda faham setiap langkah dari mula sampai selesai.',
            },
            {
              question: 'Saya perlu signboard yang proper?',
              answer:
                'Ya. Atome biasanya perlukan signboard kedai yang proper, bukan sekadar banner. Kalau kedai anda nampak established tapi belum cukup syarat ini, kami boleh semak dulu.',
            },
            {
              question: 'Saya perlu cashier counter?',
              answer: 'Ya. Untuk kedai fizikal, Atome biasanya perlukan setup cashier counter.',
            },
            {
              question: 'Berapa lama proses assessment?',
              answer:
                'Biasanya sehingga 2 minggu sebelum kontrak sedia untuk ditandatangani, bergantung pada dokumen dan proses semakan.',
            },
          ],
        },
        {
          title: 'Kesesuaian bisnes',
          items: [
            {
              question: 'Kenapa tak biar pelanggan guna installment credit card je?',
              answer:
                'Ramai pelanggan tak ada credit card, terutamanya golongan muda. Atome bagi mereka pilihan ansuran melalui app, jadi jualan anda tak bergantung pada pengguna credit card sahaja.',
            },
            {
              question: 'Boleh mohon kalau bisnes saya di luar Malaysia?',
              answer: 'Tak boleh. Atome Malaysia hanya terima bisnes yang berdaftar di Malaysia.',
            },
            {
              question: 'Macam mana kalau saya jalankan kedai online?',
              answer:
                'Boleh, tapi laman anda perlu ada checkout page yang proper. Dalam sesetengah kes, Atome mungkin minta screenshot atau live demo semasa assessment.',
            },
            {
              question: 'Atome akan minta product list?',
              answer:
                'Kadang-kadang, terutamanya semasa assessment. Elok sediakan SKU atau product list lebih awal.',
            },
            {
              question: 'Macam mana kalau bisnes saya dalam kategori berisiko tinggi?',
              answer:
                'Semakan mungkin ambil masa lebih lama. Atome mungkin minta dokumen atau kelulusan tambahan bergantung pada kategori bisnes.',
            },
          ],
        },
      ],
      supportNote: 'Ada soalan lain? WhatsApp kami dan kami terangkan dengan lebih lanjut.',
    },
    note: {
      title: 'Nota penting',
      body: 'Novalink bantu uruskan enquiry merchant dan panduan onboarding. Kami bukan pasukan dalaman Atome. Kelayakan dan kelulusan akhir bergantung pada semakan dan keperluan Atome.',
      linkLabel: 'Ketahui lebih lanjut di laman rasmi Atome Malaysia',
      linkHref: 'https://www.atome.my/en-my/business',
    },
    finalCta: {
      title: 'Sedia untuk mula?',
      body: 'WhatsApp kami dengan nama bisnes, jenis bisnes, dan lokasi anda. Kami buat semakan awal dan terangkan langkah seterusnya.',
      primaryCta: 'Buat enquiry merchant',
      secondaryCta: 'WhatsApp untuk maklumat lanjut',
    },
  },
  en: {
    metaTitle: 'Atome Merchant Enquiry',
    metaDescription:
      'Atome merchant enquiry page for first-step guidance, an initial check, and onboarding support by Novalink.',
    hero: {
      headline: 'Want to offer Atome to your customers?',
      subheadline:
        'Help your business add another payment option at checkout with clearer enquiry and onboarding guidance.',
      supportLine:
        'Atome is a Buy Now Pay Later (BNPL) / instalment payment option that gives customers more flexibility at the point of purchase.',
      trustLine: 'No setup fee · No monthly fee',
      primaryCta: 'Start merchant enquiry',
      secondaryText: 'WhatsApp for more information',
    },
    explainer: {
      title: 'What is Atome Buy Now Pay Later?',
      bullets: [
        'Customers can make a purchase now and pay in instalments',
        'Atome Malaysia explains its offering around 3 interest-free payments',
        'For some transactions, longer-tenure options may also be available with fees shown clearly in the app',
        'The first payment is made at the point of purchase, and the remaining payments are scheduled in the app',
        'For merchants, this adds another payment option at checkout',
      ],
      linkLabel: 'Refer to the official Atome Malaysia website',
      linkHref: 'https://www.atome.my/en-my/how-it-works',
    },
    why: {
      title: 'Why merchants may consider Atome',
      cards: [
        {
          title: 'Offer customers another payment option',
          body: 'Give customers an additional way to pay at checkout, depending on merchant and transaction suitability.',
        },
        {
          title: 'Support higher-consideration purchases',
          body: 'A more flexible payment option may help customers feel more comfortable proceeding with a purchase.',
        },
        {
          title: 'No setup fee, no monthly fee',
          body: 'Merchants are charged an MDR per transaction. Full terms are clarified during onboarding.',
        },
        {
          title: 'Clear guidance at every step',
          body: 'We explain what to prepare, what Atome will review, and what happens after that.',
        },
      ],
    },
    howItWorks: {
      title: 'How it works',
      steps: [
        {
          title: 'Send an enquiry',
          body: 'Contact us on WhatsApp for an initial check.',
        },
        {
          title: 'Share basic business information',
          body: 'We will ask for basic details such as your business type, location, and business channels.',
        },
        {
          title: 'Receive guidance on the next steps',
          body: 'If suitable, you will receive guidance on what to prepare and what comes next.',
        },
        {
          title: 'Proceed with onboarding where applicable',
          body: 'Eligibility and approval remain subject to review and relevant requirements.',
        },
      ],
    },
    suitableFor: {
      title: 'Suitable for businesses like…',
      bullets: [
        'Businesses that want to offer customers another payment option',
        'Businesses handling purchases where payment flexibility may help',
        'Merchants willing to go through review and onboarding steps',
        'Businesses exploring additional payment options in a more structured way',
      ],
    },
    prepare: {
      title: 'What to prepare before enquiry',
      intro: 'To make the initial review easier, prepare the following:',
      bullets: ['Business name', 'Business type', 'Location / area', 'Website or social page, if available'],
      primaryCta: 'Start merchant enquiry',
      secondaryText: 'WhatsApp for an initial check',
    },
    faq: {
      title: 'FAQ',
      mainItems: [
        {
          question: 'Is Novalink part of Atome?',
          answer:
            'No. Novalink supports merchant enquiry coordination and onboarding guidance. Novalink is not part of Atome’s internal team.',
        },
        {
          question: 'Is every business eligible?',
          answer: 'Not necessarily. Suitability depends on review and relevant requirements.',
        },
        {
          question: 'Does this enquiry guarantee approval?',
          answer: 'No. An initial enquiry does not guarantee approval. Eligibility and approval remain subject to review.',
        },
        {
          question: 'What information is needed to get started?',
          answer:
            'Usually basic information such as your business name, business type, location, and business channels.',
        },
        {
          question: 'Is there any fee to make an enquiry?',
          answer: 'There is no fee for an initial enquiry.',
        },
        {
          question: 'Do I need special hardware or integration?',
          answer:
            'Not necessarily. For physical stores, Atome uses a QR-based payment flow. For online stores, integration depends on your platform and sales channels.',
        },
        {
          question: 'Can my business appear in the Atome app?',
          answer:
            'Yes. Atome has the ability to feature merchants in the app, subject to their process and requirements.',
        },
        {
          question: 'Will every customer have the same spending limit?',
          answer:
            'No. Customer eligibility and spending limits can vary depending on the user profile, payment type, and Atome’s assessment.',
        },
        {
          question: 'How is merchant pricing determined?',
          answer:
            'There is no setup fee. Merchant pricing is based on MDR per transaction, and the commercial terms will be clarified during onboarding.',
        },
      ],
      supportLine:
        'Need help with fees, onboarding, business suitability, or online store requirements? WhatsApp us for an initial check.',
      moreTitle: 'More merchant questions',
      moreGroups: [
        {
          title: 'Fees & commercial terms',
          items: [
            {
              question: 'What makes Atome different from other pay-later options?',
              answer:
                'Atome is not just another checkout payment option. Merchants may also gain visibility inside the Atome app, benefit from selected campaigns or vouchers, and be more accessible to debit-card users who may not use credit cards.',
            },
            {
              question: 'What happens if the customer does not pay Atome back?',
              answer:
                'Customer repayment handling is managed under Atome’s own process. Merchant settlement flow and related terms will be clarified during onboarding.',
            },
            {
              question: 'How many people use Atome?',
              answer:
                'Atome has a large user base in Malaysia and across the region. Beyond checkout, merchants may also gain visibility inside the Atome app.',
            },
            {
              question: 'What is the Atome fee?',
              answer:
                'For the merchants we typically handle, the fee structure we usually explain is 6% + RM1 per transaction. There is no setup fee and no monthly fee. Final confirmation remains subject to onboarding terms.',
            },
            {
              question: 'Can merchants get a lower rate than 6%?',
              answer:
                'Yes, in some cases. Merchants with high GMV, multiple branches, or strong brand profile may be able to negotiate a better rate with Atome.',
            },
            {
              question: 'Will every customer have the same credit limit?',
              answer:
                'No. Customer limits vary depending on the user profile, payment type, and repayment activity.',
            },
          ],
        },
        {
          title: 'Setup & onboarding',
          items: [
            {
              question: 'Is onboarding difficult?',
              answer:
                'Not difficult if the basic information and documents are prepared properly. We help merchants understand the first steps and what comes next.',
            },
            {
              question: 'Do I need a proper signboard?',
              answer:
                'Yes. Atome usually requires a proper shop signboard, not just a banner. If the merchant appears established but has not met this yet, we can help check first.',
            },
            {
              question: 'Do I need a cashier counter?',
              answer: 'Yes. Atome usually requires a cashier counter setup for physical stores.',
            },
            {
              question: 'How long does assessment usually take?',
              answer:
                'Usually up to 2 weeks before the contract is ready for signing, depending on documents and the review process.',
            },
          ],
        },
        {
          title: 'Business suitability',
          items: [
            {
              question: 'Why not just rely on credit card instalments?',
              answer:
                'Many customers do not have credit cards, especially younger users. Atome gives them another instalment payment option through the app, so your business is not limited to credit card users only.',
            },
            {
              question: 'Can I apply if my business is outside Malaysia?',
              answer: 'No. Atome Malaysia only accepts businesses registered in Malaysia.',
            },
            {
              question: 'What if I run an online shop?',
              answer:
                'You may still apply, but your site should have a proper checkout page. In some cases, Atome may request screenshots or a live demo during assessment.',
            },
            {
              question: 'Will Atome ask for my product list?',
              answer:
                'Sometimes, especially during assessment. Merchants should be ready to provide SKU or product lists if requested.',
            },
            {
              question: 'What if my business is in a higher-risk category?',
              answer:
                'This may require a more thorough review. Atome may request additional documents or approvals depending on the business category.',
            },
          ],
        },
      ],
      supportNote: 'Have another question? WhatsApp us and we will walk you through it.',
